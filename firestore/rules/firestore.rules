rules_version = '2';

// Firestore security rules for the Supporters Bus Attendance App.
//
// The source of truth for permissions is custom claims on the Firebase Auth
// token: { admin: true, helper: true }. Privileged actions (sending
// notifications, approving guests, recalculating capacity, importing members,
// assigning helpers, overriding responses) are routed through Cloud Functions
// and are not allowed via direct client writes here.
//
// Many cross-document checks (e.g. "is the selected stop active and of the
// right type?") are also enforced inside Cloud Functions because Firestore
// rules cannot perform multi-collection joins efficiently. The rules below
// enforce as much as possible at the rule layer to keep a defence in depth.

service cloud.firestore {
  match /databases/{database}/documents {

    // -------- helpers --------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isHelper() {
      return isSignedIn() && request.auth.token.helper == true;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAssignedHelper(eventId) {
      return isSignedIn() && exists(
        /databases/$(database)/documents/events/$(eventId)/helpers/$(request.auth.uid)
      );
    }

    // True if the signed-in user has an active link to the given member.
    function userIsLinkedToMember(memberId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/memberUserLinks/$(request.auth.uid + '_' + memberId));
    }

    // Convenience: the field has not changed between request.resource and
    // resource (i.e. the client is not trying to mutate it).
    function unchanged(field) {
      return resource.data[field] == request.resource.data[field];
    }

    // -------- users --------

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();

      // A user may create their own profile on first login. Roles must default
      // to ["user"] and isActive to true; any other elevation must come from a
      // Cloud Function with admin privileges.
      allow create: if isSelf(userId)
        && request.resource.data.roles.hasOnly(['user'])
        && request.resource.data.isActive == true;

      // Users can update only display name and updatedAt on their own record.
      allow update: if (
          isSelf(userId)
          && request.resource.data.roles == resource.data.roles
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.phoneE164 == resource.data.phoneE164
        ) || isAdmin();

      allow delete: if isAdmin();

      // FCM tokens — owned by the user.
      match /fcmTokens/{tokenId} {
        allow read, write, delete: if isSelf(userId);
      }
    }

    // -------- members --------

    match /members/{memberId} {
      // Anyone signed in can read members so the app can display
      // names/phone for linked members. (For stricter privacy this can be
      // tightened to only members the user is linked to + admins; left open
      // for MVP simplicity.)
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // -------- memberUserLinks --------
    // Document IDs SHOULD use the convention `${userId}_${memberId}` so the
    // helper above can perform an O(1) existence check.

    match /memberUserLinks/{linkId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Users may create a *pending* link for themselves during signup. Admin
      // approval is required before the link becomes active.
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedDuringSignup == true
      );

      // Only admins can change link status, role, or approval metadata.
      allow update, delete: if isAdmin();
    }

    // -------- events --------

    match /events/{eventId} {
      // Users only see events with status open/closed/completed/cancelled.
      // Drafts are admin-only; admins see everything.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.status != 'draft');

      allow create, delete: if isAdmin();

      // Most event fields are admin-only. Helpers may update parkedBusLocation
      // on assigned events; the rule below allows that and disallows other
      // changes by helpers. Cloud Functions enforce additional invariants.
      allow update: if isAdmin() || (
        isHelper() && isAssignedHelper(eventId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['parkedBusLocation', 'updatedAt'])
      );

      // -------- stops --------
      match /stops/{stopId} {
        allow read: if isAdmin()
          || (isSignedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.status != 'draft');
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (isHelper() && isAssignedHelper(eventId));
      }

      // -------- helpers --------
      match /helpers/{userId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create, update, delete: if isAdmin();
      }

      // -------- memberResponses --------
      match /memberResponses/{memberId} {
        allow read: if isAdmin()
          || (isSignedIn() && userIsLinkedToMember(memberId));

        // Users may create/update their own member's response, before cutoff.
        // Cloud Functions perform the deeper validation (cutoff, stop type
        // match, link active, member active, event open).
        allow create, update: if isAdmin() || (
          isSignedIn()
          && userIsLinkedToMember(memberId)
          && request.resource.data.memberId == memberId
          && request.resource.data.respondingUserId == request.auth.uid
          && request.resource.data.isAdminOverride == false
        );

        allow delete: if isAdmin();
      }

      // -------- guestRequests --------
      match /guestRequests/{guestRequestId} {
        allow read: if isAdmin()
          || (isSignedIn() && resource.data.requestedByUserId == request.auth.uid);

        // Users create pending guest requests for themselves only. Approval /
        // rejection happens through Cloud Functions.
        allow create: if isAdmin() || (
          isSignedIn()
          && request.resource.data.requestedByUserId == request.auth.uid
          && request.resource.data.status == 'pending'
        );

        // Users may edit/cancel their own *pending* requests; everything else
        // (approve/reject) goes through Cloud Functions running as admin.
        allow update: if isAdmin() || (
          isSignedIn()
          && resource.data.requestedByUserId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.requestedByUserId == request.auth.uid
          && (request.resource.data.status == 'pending'
              || request.resource.data.status == 'cancelled')
        );

        allow delete: if isAdmin();
      }
    }

    // -------- notifications --------
    // Notifications are written exclusively by Cloud Functions. Clients may
    // read notifications addressed to them.

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.targetUserIds);
      allow write: if false;
    }

    // -------- audit logs --------

    match /auditLogs/{auditLogId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
